{
  "name": "@tsci/mohan-bee.rv1106g2-mini",
  "version": "1.0.0",
  "description": "50 mm four-layer RV1106G2 top-side prototype with onboard 5 V regulation",
  "main": "index.circuit.tsx",
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build --autorouter-debug --autorouter-timeout 15m --autorouter-dump-srj all --disable-parts-engine --pcb-png --schematic-png --svgs",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "tscircuit": "^0.0.2479",
    "typescript": "^5.0.0"
  },
  "author": "mohan-bee"
}
